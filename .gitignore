# Raw and prepared datasets live in ~/datasets/, never in git
data/*
!data/.gitkeep
*.zip
*.nii
*.nii.gz

# External repositories are cloned locally; their exact commits are pinned in external/VERSIONS.md
external/*
!external/VERSIONS.md

# Checkpoints and pretrained weights
*.pt
*.pth
*.pth.tar
*.ckpt
*.npz
pretrained/

# Large training artefacts (logs, checkpoints, predicted masks, nnU-Net folders)
runs/*
!runs/.gitkeep
nnUNet_raw/
nnUNet_preprocessed/
nnUNet_results/

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Local Chinese reading copies of the docs; GitHub content is English only
*_zh_CN.md

# Personal Claude Code overrides (the shared hooks are in .claude/settings.json)
.claude/settings.local.json

# Phase 2 text tables: they contain the dataset's annotation texts (reproduced by src/phase2/*.py)
results/phase2_text_attributes.csv
results/phase2_text_conditions*.csv
