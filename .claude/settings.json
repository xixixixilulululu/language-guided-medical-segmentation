    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/src/claude_notify_hook.sh stop",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
