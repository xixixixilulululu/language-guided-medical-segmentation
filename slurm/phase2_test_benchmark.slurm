#!/bin/bash
# DRAFT (2026-10-28) - not to be submitted before the freeze (reports/PHASE2_PROTOCOL_FREEZE.md, section 7).
# Phase 2: TEST benchmark (PHASE2_PLAN Task 2.3 on the test split), all 18 checkpoints, all conditions C0-C6 with
# every donor, generated by the frozen rules. Amendment A1: float32 probabilities of every pass are kept
# (Phase 3 reads them). Then the test C0 reconciliation with the Phase 1 test archive (P2-2).
# Order of checks, before anything of the test split is read:
#   1. Phase 2 lock open (frozen record, all files unchanged, commit on origin/main); exit 5 otherwise
#   2. Test text files linked into the text view (`python src/phase2/lock.py link-test`, login node, by hand)
#   3. Frozen Phase 1 drivers unchanged
# Every test pass is logged (results/phase2_test_eval_log.tsv, passes.tsv). Resumable: finished passes are
# skipped. A rerun after an error is recorded in the test log (PHASE2_PROTOCOL.md section 4.7). Submitted by hand.
#SBATCH --job-name=p2_benchmark_test
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=20
#SBATCH --time=12:00:00
#SBATCH --output=/mnt/cv_data/users/hahaxixi/projects/language-guided-medical-segmentation/runs/slurm_logs/%x-%j.out
set -uo pipefail
source /mnt/cv_data/users/hahaxixi/projects/language-guided-medical-segmentation/slurm/env_phase1.sh
JOB_LABEL="Phase 2 benchmark (TEST)"
# 1. lock (first: nothing else runs when it is closed)
python -c 'import sys; sys.path.insert(0, "src"); from phase2 import lock; lock.require_open(what="slurm/phase2_test_benchmark.slurm")' \
  || { echo "Phase 2 lock closed: nothing was run"; exit 5; }
# 2. text view
python -c 'import os, sys; sys.path.insert(0, "src"); from phase2 import lock
missing = [d for d in lock.DATASETS if not os.path.exists(lock.text_file(d, "test"))]
sys.exit("test texts not linked (run lock.py link-test on the login node): %s" % missing if missing else 0)' || exit 5
# 3. frozen Phase 1 drivers
for F in configs/phase1_frozen/lvit configs/phase1_frozen/reclmis configs/phase1_frozen/ddcmd; do
  sed "s#\$HOME#$HOME#" $F.sha256 | sha256sum -c --quiet - || { echo "frozen files changed: $F.sha256"; exit 1; }
  read -r REPO_DIR REPO_COMMIT < $F.commit
  [ "$(git -C $REPO_DIR rev-parse HEAD)" = "$REPO_COMMIT" ] || { echo "$REPO_DIR is not at $REPO_COMMIT"; exit 1; }
done
sha256sum -c --quiet configs/phase1_frozen/lvit_b24.sha256 || { echo "configs/lvit_sensitivity_b24.yaml changed"; exit 1; }
echo "lock open, test texts linked, frozen Phase 1 drivers verified"
lgms_notify_start
FAILED=()
for DS in MosMedData+ QaTa-COV19; do
  for M in lvit reclmis ddcmd; do
    echo "=== $(date +%T) $M $DS"
    python src/phase2/infer.py --stage benchmark --split test --method $M --dataset $DS || FAILED+=("$M/$DS")
  done
done
echo "failed: ${#FAILED[@]} ${FAILED[*]:-}"
[ ${#FAILED[@]} -eq 0 ] || exit 1
echo "=== $(date +%T) test C0 reconciliation (P2-2)"
python src/phase2/reconcile_test_c0.py || { echo "P2-2 outside the tolerance: stop, see PHASE2_PROTOCOL.md 4.7"; exit 1; }
NOTIFY_RESULT="18 checkpoints, all test condition passes done; C0 within P2-2 (runs/phase2/test)"
echo "done $(date)"
